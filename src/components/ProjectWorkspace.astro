---
import { chapterBlocksFor, overviewBlocksFor } from "../content/demo-blocks";
import type { SiteContent } from "../content/site";
import DemoBlocks from "./DemoBlocks.astro";
import MediaFrame from "./MediaFrame.astro";
import ProfileStage from "./ProfileStage.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { explorer, projects, mode, profile } = content;
const isFrench = content.locale === "fr";
const firstId = projects[0]?.id ?? "";
const isDemo = mode === "demo";
const chaptersLabel = isFrench ? "Chapitres" : "Chapters";
const projectsSwitchLabel = isFrench ? "Projets" : "Projects";
const jumpLabel = projectsSwitchLabel;
const mobileOverviewLabel = isFrench ? "Aperçu" : "Overview";
const mobileProjectsLabel = projectsSwitchLabel;
const mobileCloseLabel = isFrench ? "Fermer" : "Close";
const mobileChapterPick = isFrench ? "Choisir un chapitre" : "Choose a chapter";
const mobileProjectPick = isFrench ? "Changer de projet" : "Switch project";
const nextChapterLabel = isFrench ? "Chapitre suivant" : "Next chapter";
const nextProjectLabel = isFrench ? "Projet suivant" : "Next project";
---

<div
  class="workspace"
  id="main-content"
  data-workspace
  data-portfolio-mode={mode}
  data-view="projects"
  data-project-mode="overview"
  data-active-project={firstId}
>
  <section
    class="view view--projects is-active"
    data-view-panel="projects"
    aria-labelledby="projects-title"
  >
    <div class="projects-layout" data-projects-layout>
      <aside class="context-rail" data-context-rail>
        <div
          class="context-rail__panel context-rail__panel--overview is-active"
          data-rail-panel="overview"
          aria-hidden="false"
        >
          <p class="eyebrow" id="projects-title">
            {explorer.title}
          </p>
          <nav
            class="project-index"
            aria-label={explorer.projectIndexLabel}
            data-project-tabs
          >
            {projects.map((project, index) => (
              <button
                type="button"
                class:list={[
                  "project-index__item",
                  { "is-active": index === 0 },
                ]}
                data-project-select
                data-project-id={project.id}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="project-index__num">{project.index}</span>
                <span class="project-index__label">
                  {project.navLabel ?? project.title}
                </span>
              </button>
            ))}
          </nav>
        </div>

        <div
          class="context-rail__panel context-rail__panel--case"
          data-rail-panel="case"
          aria-hidden="true"
        >
          <div class="case-rail__projects">
            <p class="eyebrow">{projectsSwitchLabel}</p>
            <nav class="case-project-jump" aria-label={jumpLabel}>
              {projects.map((jumpProject, jumpIndex) => (
                <button
                  type="button"
                  class:list={[
                    "case-project-jump__item",
                    { "is-active": jumpIndex === 0 },
                  ]}
                  data-project-switch
                  data-project-id={jumpProject.id}
                  aria-pressed={jumpIndex === 0 ? "true" : "false"}
                  aria-label={jumpProject.navLabel ?? jumpProject.title}
                  title={jumpProject.navLabel ?? jumpProject.title}
                >
                  <span aria-hidden="true">{jumpProject.index}</span>
                </button>
              ))}
            </nav>
            <button
              type="button"
              class="text-action text-action--ghost case-rail__back"
              data-close-case-study
              data-case-rail-back
            >
              <span aria-hidden="true">←</span>
              <span>{explorer.backToProject}</span>
            </button>
          </div>

          {projects.map((project, index) => (
            <div
              class:list={["case-rail", { "is-active": index === 0 }]}
              data-case-rail
              data-project-id={project.id}
              hidden={index !== 0}
            >
              <div class="case-identity">
                <p class="eyebrow">{project.caseStudy.eyebrow}</p>
                <p class="case-identity__title">{project.title}</p>
              </div>

              <p class="case-rail__chapters-label">{chaptersLabel}</p>
              <nav
                class="chapter-index"
                aria-label={project.caseStudy.contentsLabel}
                data-chapter-nav
              >
                <span
                  class="chapter-index__indicator"
                  data-chapter-indicator
                  aria-hidden="true"
                ></span>
                {project.caseStudy.chapters.map((chapter, chapterIndex) => (
                  <button
                    type="button"
                    class:list={[
                      "chapter-index__item",
                      { "is-active": chapterIndex === 0 },
                    ]}
                    data-chapter-select
                    data-chapter-id={chapter.id}
                    data-project-id={project.id}
                    aria-pressed={chapterIndex === 0 ? "true" : "false"}
                  >
                    <span class="chapter-index__mark" aria-hidden="true" />
                    <span class="chapter-index__text">
                      <span class="chapter-index__title">{chapter.title}</span>
                      <span class="chapter-index__eyebrow">
                        {chapter.eyebrow}
                      </span>
                    </span>
                  </button>
                ))}
              </nav>
            </div>
          ))}
        </div>
      </aside>

      <div class="project-stage" data-project-stage>
        {projects.map((project, index) => {
          const overviewBlocks = isDemo
            ? overviewBlocksFor(project.id, content.locale)
            : [];
          const nextProject = projects[(index + 1) % projects.length] ?? null;
          const chapterCount = project.caseStudy.chapters.length;
          const studyHint = isFrench
            ? `${chapterCount} chapitres · ${explorer.caseStudyHint}`
            : `${chapterCount} chapters · ${explorer.caseStudyHint}`;
          return (
            <article
              class:list={["project-hero", { "is-active": index === 0 }]}
              data-project-card
              data-project-id={project.id}
              data-demonstration-only={
                project.demonstrationOnly ? "true" : "false"
              }
              aria-hidden={index === 0 ? "false" : "true"}
              aria-labelledby={`project-title-${project.id}`}
            >
              <div
                class="project-hero__overview"
                data-project-mode-panel="overview"
              >
                <div class="project-hero__media-slot" data-hero-media>
                  <MediaFrame
                    media={project.featuredMedia}
                    emptyLabel={project.mediaEmptyLabel}
                    emptyHint={project.mediaEmptyHint}
                    class="project-hero__media"
                  />
                </div>

                <div class="project-hero__copy" data-hero-copy>
                  <p class="project-hero__kicker">
                    <span>{explorer.activeLabel}</span>
                    {project.demonstrationOnly ? (
                      <span class="project-hero__demo">
                        {isFrench ? "Fictif" : "Demo"}
                      </span>
                    ) : null}
                  </p>
                  <h2 id={`project-title-${project.id}`} data-project-title>
                    {project.title}
                  </h2>
                  <p class="project-hero__kind">{project.kind}</p>
                  <p class="project-hero__summary">{project.summary}</p>
                  <p class="project-hero__meta">
                    <span>{project.technologies.join(" · ")}</span>
                    <span class="project-hero__dot" aria-hidden="true" />
                    <span>{project.kit.join(" · ")}</span>
                  </p>

                  <button
                    type="button"
                    class="project-hero__study-cta"
                    data-open-case-study="copy"
                    data-project-id={project.id}
                  >
                    <span class="project-hero__study-cta-main">
                      <span>{explorer.caseStudyAction}</span>
                      <span aria-hidden="true">→</span>
                    </span>
                    <span class="project-hero__study-cta-hint">
                      {studyHint}
                    </span>
                  </button>

                  {overviewBlocks.length > 0 ? (
                    <DemoBlocks
                      blocks={overviewBlocks}
                      class="demo-blocks--overview"
                    />
                  ) : null}
                </div>
              </div>

              <div
                class="project-hero__case"
                data-project-mode-panel="case-study"
                hidden
              >
                <div class="chapter-canvas" data-chapter-stage>
                  {project.caseStudy.chapters.map((chapter, chapterIndex) => {
                    const blocks = isDemo
                      ? chapterBlocksFor(project.id, chapter.id, content.locale)
                      : [];
                    const nextChapter =
                      project.caseStudy.chapters[chapterIndex + 1] ?? null;
                    return (
                      <article
                        class:list={[
                          "chapter-panel",
                          { "is-open": chapterIndex === 0 },
                        ]}
                        data-chapter-panel
                        data-chapter-id={chapter.id}
                        aria-hidden={chapterIndex === 0 ? "false" : "true"}
                        aria-labelledby={`chapter-heading-${project.id}-${chapter.id}`}
                      >
                        <header class="chapter-panel__head">
                          <p class="eyebrow">{chapter.eyebrow}</p>
                          <h3
                            id={`chapter-heading-${project.id}-${chapter.id}`}
                          >
                            {chapter.title}
                          </h3>
                          <p class="chapter-panel__lead">{chapter.intro}</p>
                        </header>
                        <div class="chapter-panel__scroll" data-chapter-scroll>
                          <div class="chapter-panel__body">
                            {chapter.paragraphs.map((paragraph) => (
                              <p>{paragraph}</p>
                            ))}
                            {chapter.media && chapter.media.kind !== "none" ? (
                              <MediaFrame
                                media={chapter.media}
                                emptyLabel={project.mediaEmptyLabel}
                                emptyHint={project.mediaEmptyHint}
                                class="chapter-panel__media"
                              />
                            ) : null}
                            {blocks.length > 0 ? (
                              <DemoBlocks
                                blocks={blocks}
                                class="demo-blocks--chapter"
                              />
                            ) : null}
                            <footer
                              class="chapter-continue"
                              data-chapter-continue
                            >
                              {nextChapter ? (
                                <button
                                  type="button"
                                  class="chapter-continue__action"
                                  data-chapter-select
                                  data-project-id={project.id}
                                  data-chapter-id={nextChapter.id}
                                >
                                  <span class="chapter-continue__meta">
                                    <span class="chapter-continue__label">
                                      {nextChapterLabel}
                                    </span>
                                    <span class="chapter-continue__title">
                                      {nextChapter.title}
                                    </span>
                                  </span>
                                  <span
                                    class="chapter-continue__arrow"
                                    aria-hidden="true"
                                  >
                                    →
                                  </span>
                                </button>
                              ) : nextProject ? (
                                <button
                                  type="button"
                                  class="chapter-continue__action"
                                  data-project-switch
                                  data-project-id={nextProject.id}
                                >
                                  <span class="chapter-continue__meta">
                                    <span class="chapter-continue__label">
                                      {nextProjectLabel}
                                    </span>
                                    <span class="chapter-continue__title">
                                      {nextProject.navLabel ??
                                        nextProject.title}
                                    </span>
                                  </span>
                                  <span
                                    class="chapter-continue__arrow"
                                    aria-hidden="true"
                                  >
                                    →
                                  </span>
                                </button>
                              ) : null}
                            </footer>
                          </div>
                          <div
                            class="chapter-panel__edge chapter-panel__edge--top"
                            aria-hidden="true"
                          ></div>
                          <div
                            class="chapter-panel__edge chapter-panel__edge--bottom"
                            aria-hidden="true"
                          ></div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <div class="mobile-case-bar" data-mobile-case-bar hidden>
    <button type="button" class="mobile-case-bar__back" data-close-case-study>
      <span aria-hidden="true">←</span>
      <span>{mobileOverviewLabel}</span>
    </button>
    <button
      type="button"
      class="mobile-case-bar__chapter"
      data-mobile-sheet-open="chapters"
      aria-haspopup="dialog"
    >
      <span class="mobile-case-bar__eyebrow">{chaptersLabel}</span>
      <span data-mobile-chapter-label>{mobileChapterPick}</span>
    </button>
    <button
      type="button"
      class="mobile-case-bar__projects"
      data-mobile-sheet-open="projects"
      aria-haspopup="dialog"
    >
      {mobileProjectsLabel}
    </button>
  </div>

  <dialog
    class="mobile-sheet"
    data-mobile-sheet="chapters"
    aria-labelledby="mobile-sheet-chapters-title"
    tabindex="-1"
  >
    <div class="mobile-sheet__frame">
      <div class="mobile-sheet__grab" aria-hidden="true"></div>
      <header class="mobile-sheet__head">
        <h2 id="mobile-sheet-chapters-title">{chaptersLabel}</h2>
        <button
          type="button"
          class="mobile-sheet__close"
          data-mobile-sheet-close
        >
          {mobileCloseLabel}
        </button>
      </header>
      {projects.map((project, index) => (
        <nav
          class="mobile-sheet__list"
          data-mobile-chapter-group
          data-project-id={project.id}
          aria-label={project.caseStudy.contentsLabel}
          hidden={index !== 0}
        >
          {project.caseStudy.chapters.map((chapter, chapterIndex) => (
            <button
              type="button"
              class:list={[
                "mobile-sheet__item",
                { "is-active": chapterIndex === 0 },
              ]}
              data-chapter-select
              data-chapter-id={chapter.id}
              data-project-id={project.id}
              aria-pressed={chapterIndex === 0 ? "true" : "false"}
            >
              <span class="mobile-sheet__item-eyebrow">{chapter.eyebrow}</span>
              <span class="mobile-sheet__item-title">{chapter.title}</span>
            </button>
          ))}
        </nav>
      ))}
    </div>
  </dialog>

  <dialog
    class="mobile-sheet"
    data-mobile-sheet="projects"
    aria-labelledby="mobile-sheet-projects-title"
    tabindex="-1"
  >
    <div class="mobile-sheet__frame">
      <div class="mobile-sheet__grab" aria-hidden="true"></div>
      <header class="mobile-sheet__head">
        <h2 id="mobile-sheet-projects-title">{mobileProjectPick}</h2>
        <button
          type="button"
          class="mobile-sheet__close"
          data-mobile-sheet-close
        >
          {mobileCloseLabel}
        </button>
      </header>
      <nav
        class="mobile-sheet__list"
        aria-label={jumpLabel}
        data-mobile-project-sheet
      >
        {projects.map((project, index) => (
          <button
            type="button"
            class:list={["mobile-sheet__item", { "is-active": index === 0 }]}
            data-project-switch
            data-project-id={project.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span class="mobile-sheet__item-eyebrow">{project.index}</span>
            <span class="mobile-sheet__item-title">
              {project.navLabel ?? project.title}
            </span>
            <span class="mobile-sheet__item-action">
              {explorer.openStudyAction}
            </span>
          </button>
        ))}
      </nav>
    </div>
  </dialog>

  <section
    class="view view--profile"
    data-view-panel="profile"
    aria-labelledby="profile-title"
    aria-hidden="true"
    hidden
  >
    <ProfileStage profile={profile} />
  </section>
</div>
