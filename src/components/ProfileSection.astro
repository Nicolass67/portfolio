---
/**
 * Legacy page-section wrapper. Workspace uses ProfileStage via ProjectWorkspace.
 */
import type { SiteContent } from "../content/site";
import ProfileStage from "./ProfileStage.astro";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { profile } = content;
---

<section
  class="profile-section page-shell"
  id="profile"
  aria-labelledby="profile-title"
>
  <ProfileStage profile={profile} />
</section>
