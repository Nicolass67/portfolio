---
import type { SiteContent } from "../content/site";
import { withBase } from "../lib/paths";
import AccentExplorer from "./AccentExplorer.astro";
import BackgroundExplorer from "./BackgroundExplorer.astro";

interface Props {
  content: SiteContent;
  demoMode?: boolean;
}

const { content, demoMode = false } = Astro.props;
const isFrench = content.locale === "fr";
const navLabel = isFrench ? "Navigation principale" : "Primary navigation";
const homeHref = withBase("/");
const enHref = withBase("/en/");
/** Color explorers stay local-only; Pages ships fixed Craie / Ardoise. */
const showColorExplorers = demoMode && import.meta.env.DEV;
---

<header class="site-header" id="top">
  <div class="site-header__inner">
    <div class="brand">
      <span class="brand__role">{content.identity.role}</span>
      <span class="brand__rule" aria-hidden="true" />
      <span class="brand__specialty">Unreal Engine / C++</span>
    </div>

    <nav class="site-nav" aria-label={navLabel} data-site-nav>
      <span
        class="site-nav__indicator"
        data-nav-indicator
        aria-hidden="true"
      ></span>
      <button
        type="button"
        class="site-nav__button is-active"
        data-view-nav="projects"
        aria-pressed="true"
      >
        {content.navigation.projects}
      </button>
      <button
        type="button"
        class="site-nav__button"
        data-view-nav="profile"
        aria-pressed="false"
      >
        {content.navigation.profile}
      </button>
    </nav>

    <div class="site-header__tools">
      {showColorExplorers ? (
        <>
          <BackgroundExplorer locale={content.locale} />
          <AccentExplorer locale={content.locale} />
        </>
      ) : null}
      <nav
        class="language-switcher"
        aria-label={isFrench ? "Langues" : "Languages"}
      >
        <a
          href={homeHref}
          hreflang="fr"
          lang="fr"
          aria-label={isFrench ? "Français (actuel)" : "Français"}
          aria-current={isFrench ? "page" : undefined}
          data-language-link
        >
          <span class="language-switcher__flag" aria-hidden="true">
            <svg viewBox="0 0 3 2" focusable="false">
              <rect width="1" height="2" fill="#002395"></rect>
              <rect x="1" width="1" height="2" fill="#fff"></rect>
              <rect x="2" width="1" height="2" fill="#ed2939"></rect>
            </svg>
          </span>
          <span class="language-switcher__code">FR</span>
        </a>
        <a
          href={enHref}
          hreflang="en"
          lang="en"
          aria-label={!isFrench ? "English (current)" : "English"}
          aria-current={!isFrench ? "page" : undefined}
          data-language-link
        >
          <span class="language-switcher__flag" aria-hidden="true">
            <svg viewBox="0 0 60 40" focusable="false">
              <rect width="60" height="40" fill="#012169"></rect>
              <path
                d="M0 0 L60 40 M60 0 L0 40"
                stroke="#fff"
                stroke-width="8"
              ></path>
              <path
                d="M0 0 L60 40 M60 0 L0 40"
                stroke="#C8102E"
                stroke-width="5"
              ></path>
              <path
                d="M30 0 V40 M0 20 H60"
                stroke="#fff"
                stroke-width="12"
              ></path>
              <path
                d="M30 0 V40 M0 20 H60"
                stroke="#C8102E"
                stroke-width="7"
              ></path>
            </svg>
          </span>
          <span class="language-switcher__code">EN</span>
        </a>
      </nav>
    </div>
  </div>
</header>
